-		return parts.length > 0 ? parts[0] : ""
+		try {
+			def digest = java.security.MessageDigest.getInstance("SHA-256")
+			def file = new File(filePath)
+			file.withInputStream { is ->
+				byte[] buffer = new byte[8192]
+				int read
